# 生产环境配置：专供「把本项目整体替换旧版本 UI」的部署场景。
# 对齐旧版前端（mars/frontend/.env.production）的并入方式：
#   REACT_APP_BASE_URL=""  REACT_APP_WS_URL=""  PUBLIC_URL="/resources"
# → UI 由后端 embed 提供（/resources/ 内嵌静态资源），API /api、WS /ws 全部同源相对路径，
#   不注入任何后端绝对地址。新版 src 不消费 import.meta.env，请求恒为相对路径，与旧版一致。
# 以下 VITE_* 仅喂 vite dev server 的 server.proxy（开发代理）；生产并入同源不使用，
# 留空即同源相对——禁止填绝对域名，否则并入后端后会跨域。
VITE_API_TARGET=
VITE_WS_TARGET=
